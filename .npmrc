# --- Core PNPM Dependency Structure Settings ---
shamefully-hoist=true
auto-install-peers=true

# --- Native Framework Binary Mirrors ---
ELECTRON_MIRROR="https://npmmirror.com"
ELECTRON_BUILDER_BINARIES_MIRROR="https://npmmirror.com"

# --- Critical Security Defense (Shai-Hulud Prevention) ---
ignore-scripts=true
only-built-dependencies[]=better-sqlite3
