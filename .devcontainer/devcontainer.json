{
  "name": "Ultra Tracker Dev",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "workspaceFolder": "/workspaces/ultra-tracker",

  "mounts": [
    "source=${localWorkspaceFolder}/resources/config,target=/workspace/resources/config,type=bind"
  ],

  "postCreateCommand": "corepack enable && pnpm install",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.js-debug",
        "dbaeumer.vscode-eslint"
      ]
    }
  },

  "remoteUser": "node"
}